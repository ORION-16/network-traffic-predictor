# Application settings
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Capture settings
MAX_PACKETS=10000
WS_INTERVAL=1.0

# Demo mode — set to "true" ONLY for UI development without raw capture privileges.
# This affects the optional packet sniffer only. Interface-counter monitoring stays real.
DEMO_MODE=false

# Interface-counter monitoring
SAMPLE_INTERVAL=1.0
FORECAST_HORIZON_SECONDS=300
RETENTION_HOURS=24
# DB_PATH=data/observations.sqlite
DISABLE_PROBES=false
LATENCY_PROBE_TARGET=1.1.1.1
LATENCY_PROBE_INTERVAL=30
LATENCY_PROBE_COUNT=3
